{
  "rules": {
    "guests": {
      "$phone": { ".read": true, ".write": true }
    },
    "roomguests": {
      ".read": "auth != null",
      "$date": {
        "$room": { ".write": true }
      }
    },
    "responses": {
      "$date": {
        ".read": "auth != null",
        "$phone": { ".read": true, ".write": true }
      }
    },
    "manual": {
      "$date": {
        ".read": "auth != null",
        "$key": { ".write": "auth != null" }
      }
    },
    "menutags": {
      "$date": { ".read": true, ".write": "auth != null" }
    },
    "dietaries": { ".read": true, ".write": "auth != null" },
    "extcancel": { ".read": "auth != null", ".write": true },
    "pushsubs": {
      ".read": "auth != null",
      "$emailkey": {
        ".write": "auth != null && $emailkey == auth.token.email.toLowerCase().replace('.',',')"
      }
    },
    "notify": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('staff').child(auth.token.email.toLowerCase().replace('.',',')).child('role').val() == 'admin' || root.child('staff').child(auth.token.email.toLowerCase().replace('.',',')).child('role').val() == 'staff')"
    },
    "staff": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('staff').child(auth.token.email.toLowerCase().replace('.',',')).child('role').val() == 'admin' || root.child('staff').child(auth.token.email.toLowerCase().replace('.',',')).child('role').val() == 'staff')"
    },
    "hk": {
      "$date": {
        ".read": "auth != null",
        "$villa": {
          ".write": "auth != null",
          "kind": {
            ".write": "auth != null && (root.child('staff').child(auth.token.email.toLowerCase().replace('.',',')).child('role').val() == 'admin' || root.child('staff').child(auth.token.email.toLowerCase().replace('.',',')).child('role').val() == 'staff')"
          }
        }
      }
    },
    "bookings": {
      "$id": {
        ".read": true,
        "pms": {
          ".write": "auth != null && (root.child('staff').child(auth.token.email.toLowerCase().replace('.',',')).child('role').val() == 'sync' || root.child('staff').child(auth.token.email.toLowerCase().replace('.',',')).child('role').val() == 'admin' || root.child('staff').child(auth.token.email.toLowerCase().replace('.',',')).child('role').val() == 'staff')"
        },
        "prearrival": { ".write": true },
        "dining": { ".write": "auth != null" }
      }
    },
    "stays": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('staff').child(auth.token.email.toLowerCase().replace('.',',')).child('role').val() == 'sync' || root.child('staff').child(auth.token.email.toLowerCase().replace('.',',')).child('role').val() == 'admin' || root.child('staff').child(auth.token.email.toLowerCase().replace('.',',')).child('role').val() == 'staff')"
    },
    "$other": { ".read": "auth != null", ".write": "auth != null" }
  }
}
