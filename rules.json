{
  "rules": {
    "guests": {
      "$phone": { ".read": true, ".write": true }
    },
    "roomguests": {
      ".read": "auth != null",
      "$date": {
        "$room": { ".write": true }
      }
    },
    "responses": {
      "$date": {
        ".read": "auth != null",
        "$phone": { ".read": true, ".write": true }
      }
    },
    "manual": {
      "$date": {
        ".read": "auth != null",
        "$key": { ".write": "auth != null" }
      }
    },
    "menutags": {
      "$date": { ".read": true, ".write": "auth != null" }
    },
    "dietaries": { ".read": true, ".write": "auth != null" },
    "extcancel": { ".read": "auth != null", ".write": true },
    "staff": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('staff').child(auth.token.email.toLowerCase().replace('.',',')).child('role').val() == 'staff'"
    },
    "hk": {
      "$date": {
        ".read": "auth != null",
        "$villa": {
          ".write": "auth != null",
          "kind": {
            ".write": "auth != null && root.child('staff').child(auth.token.email.toLowerCase().replace('.',',')).child('role').val() == 'staff'"
          }
        }
      }
    },
    "$other": { ".read": "auth != null", ".write": "auth != null" }
  }
}
