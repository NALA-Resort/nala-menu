{
  "rules": {
    "_comment_old_scheme": "guests, roomguests and responses are the old scheme, keyed on a phone number or written by a guest page. Nothing writes them since 17 Aug: the dinner cell replaced responses, and Mews records who is in a villa through stays. They are read-only for staff now, kept only so the boards can fall back while old dates age out. Delete the nodes and these rules once no date within the look-back window still uses them.",
    "guests": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('staff').child(auth.token.email.toLowerCase().replace('.',',')).child('role').val() == 'admin'"
    },
    "roomguests": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('staff').child(auth.token.email.toLowerCase().replace('.',',')).child('role').val() == 'admin'"
    },
    "responses": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('staff').child(auth.token.email.toLowerCase().replace('.',',')).child('role').val() == 'admin'"
    },
    "dinner": {
      "$date": {
        ".read": true,
        "$villa": {
          ".write": "auth != null || !data.exists() || data.child('by').val() != 'staff'"
        }
      }
    },
    "manual": {
      "$date": {
        ".read": "auth != null",
        "$key": { ".write": "auth != null" }
      }
    },
    "menutags": {
      "$date": { ".read": true, ".write": "auth != null" }
    },
    "dietaries": { ".read": true, ".write": "auth != null" },
    "pushsubs": {
      ".read": "auth != null",
      "$emailkey": {
        ".write": "auth != null && $emailkey == auth.token.email.toLowerCase().replace('.',',')"
      }
    },
    "notify": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('staff').child(auth.token.email.toLowerCase().replace('.',',')).child('role').val() == 'admin' || root.child('staff').child(auth.token.email.toLowerCase().replace('.',',')).child('role').val() == 'staff')"
    },
    "staff": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('staff').child(auth.token.email.toLowerCase().replace('.',',')).child('role').val() == 'admin' || root.child('staff').child(auth.token.email.toLowerCase().replace('.',',')).child('role').val() == 'staff')"
    },
    "hk": {
      "$date": {
        ".read": "auth != null",
        "$villa": {
          ".write": "auth != null",
          "kind": {
            ".write": "auth != null && (root.child('staff').child(auth.token.email.toLowerCase().replace('.',',')).child('role').val() == 'admin' || root.child('staff').child(auth.token.email.toLowerCase().replace('.',',')).child('role').val() == 'staff')"
          }
        }
      }
    },
    "bookings": {
      "$id": {
        ".read": true,
        "pms": {
          ".write": "auth != null && (root.child('staff').child(auth.token.email.toLowerCase().replace('.',',')).child('role').val() == 'sync' || root.child('staff').child(auth.token.email.toLowerCase().replace('.',',')).child('role').val() == 'admin' || root.child('staff').child(auth.token.email.toLowerCase().replace('.',',')).child('role').val() == 'staff')"
        },
        "prearrival": { ".write": true },
        "dining": { ".write": "auth != null" }
      }
    },
    "stays": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('staff').child(auth.token.email.toLowerCase().replace('.',',')).child('role').val() == 'sync' || root.child('staff').child(auth.token.email.toLowerCase().replace('.',',')).child('role').val() == 'admin' || root.child('staff').child(auth.token.email.toLowerCase().replace('.',',')).child('role').val() == 'staff')"
    },
    "$other": { ".read": "auth != null", ".write": "auth != null" }
  }
}
