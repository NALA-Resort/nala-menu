{
  "_comment": [
    "The pre-arrival form's stamps as every open card must say them:",
    "formStamps in nala-shared.js, read by the Front Desk (summary and form)",
    "and the Guest Profile. fd_suite and guest_suite both answer to this",
    "table - the presms_cases.json pattern, so whichever reading drifts fails",
    "by name. Add a case here, not to a suite.",
    "",
    "The owner's rulings of 28 Sep, one question at a time: the FIRST opening",
    "(firstOpenedAt) and the LATEST (openedAt) are both kept; the lines run in",
    "TIME ORDER; who completed it is recorded, guest or desk (completedBy).",
    "",
    "Expected lines are read in `zone`, the resort's: every stamp below is",
    "written in UTC, and several fall on the next day there, so a day sliced",
    "off the string instead of read from the parsed stamp fails here."
  ],
  "zone": "Australia/Brisbane",
  "cases": [
    { "name": "a link never opened says nothing",
      "pre": null,
      "stay": { "arrive": "2026-09-26", "depart": "2026-09-27" },
      "lines": [] },

    { "name": "opened once is one line",
      "pre": { "firstOpenedAt": "2026-09-25T09:10:00Z",
               "openedAt": "2026-09-25T09:10:00Z" },
      "stay": { "arrive": "2026-09-26", "depart": "2026-09-27" },
      "lines": ["Opened Fri 25 Sep 7:10pm"] },

    { "name": "a second landing in the same minute is still one opening",
      "pre": { "firstOpenedAt": "2026-09-25T09:10:05Z",
               "openedAt": "2026-09-25T09:10:48Z" },
      "stay": { "arrive": "2026-09-26", "depart": "2026-09-27" },
      "lines": ["Opened Fri 25 Sep 7:10pm"] },

    { "name": "a guest who came back has a first and a last",
      "pre": { "firstOpenedAt": "2026-09-25T09:10:00Z",
               "openedAt": "2026-09-25T22:30:00Z" },
      "stay": { "arrive": "2026-09-26", "depart": "2026-09-27" },
      "lines": ["Opened Fri 25 Sep 7:10pm", "Last opened Sat 26 Sep 8:30am"] },

    { "name": "sent by the guest, then looked at again: the last opening comes last",
      "pre": { "firstOpenedAt": "2026-09-25T09:10:00Z",
               "at": "2026-09-26T04:08:00Z", "completedBy": "guest",
               "openedAt": "2026-09-26T05:49:00Z",
               "dining": true, "pax": 2, "noDiets": true, "arriveSlot": "15" },
      "stay": { "arrive": "2026-09-26", "depart": "2026-09-27" },
      "lines": ["Opened Fri 25 Sep 7:10pm",
                "Completed by guest Sat 26 Sep 2:08pm",
                "Last opened Sat 26 Sep 3:49pm"] },

    { "name": "sent on a second visit: the last opening comes before the completion",
      "pre": { "firstOpenedAt": "2026-09-24T21:00:00Z",
               "openedAt": "2026-09-25T22:30:00Z",
               "at": "2026-09-25T22:41:00Z", "completedBy": "guest",
               "dining": true, "pax": 2, "noDiets": true, "arriveSlot": "15" },
      "stay": { "arrive": "2026-09-26", "depart": "2026-09-27" },
      "lines": ["Opened Fri 25 Sep 7:00am",
                "Last opened Sat 26 Sep 8:30am",
                "Completed by guest Sat 26 Sep 8:41am"] },

    { "name": "completed at the desk before the guest ever looked reads in that order",
      "pre": { "at": "2026-09-26T04:08:00Z", "completedBy": "desk",
               "firstOpenedAt": "2026-09-26T05:49:00Z",
               "openedAt": "2026-09-26T05:49:00Z",
               "dining": true, "pax": 2, "noDiets": true, "arriveSlot": "15" },
      "stay": { "arrive": "2026-09-26", "depart": "2026-09-27" },
      "lines": ["Completed at the desk Sat 26 Sep 2:08pm",
                "Opened Sat 26 Sep 3:49pm"] },

    { "name": "a record from before the first opening was kept: its one stamp is the last",
      "pre": { "at": "2026-09-26T04:08:00Z", "openedAt": "2026-09-26T05:49:00Z",
               "dining": true, "pax": 2,
               "diets": ["Vegetarian"], "dnote": "no egg", "arriveSlot": "before2" },
      "stay": { "arrive": "2026-09-26", "depart": "2026-09-27" },
      "lines": ["Completed Sat 26 Sep 2:08pm", "Last opened Sat 26 Sep 3:49pm"] },

    { "name": "an old record never completed says only its last opening",
      "pre": { "openedAt": "2026-09-23T09:02:00Z", "arriveSlot": "16" },
      "stay": { "arrive": "2026-09-26", "depart": "2026-09-30" },
      "lines": ["Last opened Wed 23 Sep 7:02pm"] },

    { "name": "a stamp beside a form missing its dinner answer is no completion",
      "pre": { "firstOpenedAt": "2026-09-25T09:10:00Z",
               "at": "2026-09-26T04:08:00Z", "completedBy": "guest",
               "noDiets": true, "arriveSlot": "15" },
      "stay": { "arrive": "2026-09-26", "depart": "2026-09-27" },
      "lines": ["Opened Fri 25 Sep 7:10pm"] },

    { "name": "three nights owe the massage answer, so a stamp without it is no completion",
      "pre": { "firstOpenedAt": "2026-09-25T09:10:00Z",
               "at": "2026-09-26T04:08:00Z", "completedBy": "guest",
               "dining": true, "pax": 2, "noDiets": true, "arriveSlot": "15" },
      "stay": { "arrive": "2026-09-26", "depart": "2026-09-29" },
      "lines": ["Opened Fri 25 Sep 7:10pm"] },

    { "name": "with the massage answer the same three nights are completed",
      "pre": { "firstOpenedAt": "2026-09-25T09:10:00Z",
               "at": "2026-09-26T04:08:00Z", "completedBy": "guest",
               "dining": true, "pax": 2, "noDiets": true, "wellness": false,
               "arriveSlot": "15" },
      "stay": { "arrive": "2026-09-26", "depart": "2026-09-29" },
      "lines": ["Opened Fri 25 Sep 7:10pm",
                "Completed by guest Sat 26 Sep 2:08pm"] },

    { "name": "completed before who was recorded is a plain Completed",
      "pre": { "at": "2026-09-26T04:08:00Z",
               "dining": false, "noDiets": true, "arriveSlot": "15" },
      "stay": { "arrive": "2026-09-26", "depart": "2026-09-27" },
      "lines": ["Completed Sat 26 Sep 2:08pm"] },

    { "name": "and a who nobody writes is a plain Completed too",
      "pre": { "at": "2026-09-26T04:08:00Z", "completedBy": "chef",
               "dining": false, "noDiets": true, "arriveSlot": "15" },
      "stay": { "arrive": "2026-09-26", "depart": "2026-09-27" },
      "lines": ["Completed Sat 26 Sep 2:08pm"] },

    { "name": "Python's six-digit fractions and a local offset read the same",
      "pre": { "firstOpenedAt": "2026-09-25T19:10:00.123456+10:00",
               "at": "2026-09-26T14:08:00.654321+10:00", "completedBy": "desk",
               "openedAt": "2026-09-25T19:10:00.123456+10:00",
               "dining": true, "pax": 2, "noDiets": true, "arriveSlot": "15" },
      "stay": { "arrive": "2026-09-26", "depart": "2026-09-27" },
      "lines": ["Opened Fri 25 Sep 7:10pm",
                "Completed at the desk Sat 26 Sep 2:08pm"] },

    { "name": "a stamp that does not parse is left out, never Invalid Date",
      "pre": { "firstOpenedAt": "not a time", "openedAt": "2026-09-25T09:10:00Z" },
      "stay": { "arrive": "2026-09-26", "depart": "2026-09-27" },
      "lines": ["Last opened Fri 25 Sep 7:10pm"] }
  ]
}
